using BepInEx;
using HarmonyLib;
using System;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.SceneManagement;

[BepInPlugin(PluginGUID, PluginName, PluginVersion)]
public sealed class BeforeStart : BaseUnityPlugin
{
    public const string PluginGUID = "Sapphire009.BeforeStart";
    public const string PluginName = "BeforeStart";
    public const string PluginVersion = "1.0.1";

    private const float MinimumJumpLockDuration = 10f;
    private const float MaximumJumpLockDuration = 15f;

    private static bool airportWasVisited;
    private static bool waitingForFirstMapCharacter;
    private static bool firstMapProtectionConsumed;

    private static int protectedSceneHandle = -1;

    private static bool jumpLockActive;
    private static int protectedCharacterId = -1;
    private static float jumpLockStartedAt;

    private static readonly Dictionary<int, float> OriginalJumpImpulses =
        new Dictionary<int, float>();

    private Harmony harmony;

    private void Awake()
    {
        harmony = new Harmony(PluginGUID);
        harmony.PatchAll();

        SceneManager.sceneLoaded += OnSceneLoaded;

        Scene activeScene = SceneManager.GetActiveScene();

        if (IsAirportScene(activeScene))
        {
            RegisterAirportVisit();
        }
    }

    private void Update()
    {
        TryStartJumpLock();
        UpdateJumpLock();
    }

    private void OnDestroy()
    {
        SceneManager.sceneLoaded -= OnSceneLoaded;

        ResetAllState();

        if (harmony != null)
        {
            harmony.UnpatchSelf();
            harmony = null;
        }
    }

    private static void OnSceneLoaded(
        Scene scene,
        LoadSceneMode loadSceneMode)
    {
        if (IsAirportScene(scene))
        {
            RegisterAirportVisit();
            return;
        }

        if (airportWasVisited &&
            !firstMapProtectionConsumed &&
            IsGameplayMapScene(scene))
        {
            protectedSceneHandle = scene.handle;

            waitingForFirstMapCharacter = true;

            jumpLockActive = false;
            protectedCharacterId = -1;

            OriginalJumpImpulses.Clear();
        }
    }

    private static void RegisterAirportVisit()
    {
        airportWasVisited = true;
        waitingForFirstMapCharacter = false;
        firstMapProtectionConsumed = false;

        protectedSceneHandle = -1;

        jumpLockActive = false;
        protectedCharacterId = -1;
        jumpLockStartedAt = 0f;

        OriginalJumpImpulses.Clear();
    }

    private static void TryStartJumpLock()
    {
        if (!waitingForFirstMapCharacter ||
            jumpLockActive)
        {
            return;
        }

        Scene activeScene = SceneManager.GetActiveScene();

        if (activeScene.handle != protectedSceneHandle)
        {
            return;
        }

        Character character = Character.localCharacter;

        if (character == null ||
            !character.IsLocal ||
            character.data == null)
        {
            return;
        }

        CharacterMovement movement = ResolveMovement(character);

        if (movement == null)
        {
            return;
        }

        protectedCharacterId = character.GetInstanceID();
        jumpLockStartedAt = Time.time;

        jumpLockActive = true;
        waitingForFirstMapCharacter = false;
        firstMapProtectionConsumed = true;

        int movementId = movement.GetInstanceID();

        if (movement.jumpImpulse > 0f)
        {
            OriginalJumpImpulses[movementId] = movement.jumpImpulse;
        }
    }

    private static void UpdateJumpLock()
    {
        if (!jumpLockActive)
        {
            return;
        }

        Character character = Character.localCharacter;

        if (character == null ||
            !character.IsLocal ||
            character.GetInstanceID() != protectedCharacterId ||
            character.data == null)
        {
            EndJumpLock();
            return;
        }

        float elapsed = Time.time - jumpLockStartedAt;

        bool minimumDurationFinished =
            elapsed >= MinimumJumpLockDuration;

        bool maximumDurationFinished =
            elapsed >= MaximumJumpLockDuration;

        bool characterRecovered =
            HasCharacterFinishedWaking(character);

        if ((minimumDurationFinished &&
             characterRecovered) ||
            maximumDurationFinished)
        {
            EndJumpLock();
        }
    }

    private static bool HasCharacterFinishedWaking(
        Character character)
    {
        if (character == null ||
            character.data == null)
        {
            return false;
        }

        if (character.data.dead ||
            character.data.fullyPassedOut ||
            character.data.passedOut)
        {
            return false;
        }

        if (character.data.fallSeconds > 0.01f)
        {
            return false;
        }

        if (character.data.passedOutOnTheBeach > 0f)
        {
            return false;
        }

        if (character.data.currentRagdollControll < 0.9f)
        {
            return false;
        }

        if (character.data.GetTargetRagdollControll() < 0.9f)
        {
            return false;
        }

        return true;
    }

    private static void EndJumpLock()
    {
        if (!jumpLockActive)
        {
            return;
        }

        Character character = Character.localCharacter;
        CharacterMovement movement = ResolveMovement(character);

        RestoreOriginalJumpImpulse(movement);

        jumpLockActive = false;
        protectedCharacterId = -1;
        jumpLockStartedAt = 0f;

        OriginalJumpImpulses.Clear();
    }

    internal static bool ShouldBlockJump(
        CharacterMovement movement,
        out Character character)
    {
        character = ResolveCharacter(movement);

        if (!jumpLockActive ||
            movement == null ||
            character == null ||
            !character.IsLocal)
        {
            return false;
        }

        if (character.GetInstanceID() != protectedCharacterId)
        {
            return false;
        }

        Scene activeScene = SceneManager.GetActiveScene();

        if (activeScene.handle != protectedSceneHandle)
        {
            return false;
        }

        return true;
    }

    private static Character ResolveCharacter(
        Component component)
    {
        if (component == null)
        {
            return null;
        }

        Character character =
            component.GetComponent<Character>();

        if (character == null)
        {
            character =
                component.GetComponentInParent<Character>();
        }

        return character;
    }

    private static CharacterMovement ResolveMovement(
        Character character)
    {
        if (character == null)
        {
            return null;
        }

        if (character.refs != null &&
            character.refs.movement != null)
        {
            return character.refs.movement;
        }

        CharacterMovement movement =
            character.GetComponent<CharacterMovement>();

        if (movement == null)
        {
            movement =
                character.GetComponentInParent<CharacterMovement>();
        }

        return movement;
    }

    private static void CaptureOriginalJumpImpulse(
        CharacterMovement movement)
    {
        if (movement == null)
        {
            return;
        }

        int movementId = movement.GetInstanceID();

        if (OriginalJumpImpulses.ContainsKey(movementId))
        {
            return;
        }

        if (movement.jumpImpulse <= 0f)
        {
            return;
        }

        OriginalJumpImpulses.Add(
            movementId,
            movement.jumpImpulse);
    }

    private static void RestoreOriginalJumpImpulse(
        CharacterMovement movement)
    {
        if (movement == null)
        {
            return;
        }

        if (!OriginalJumpImpulses.TryGetValue(
                movement.GetInstanceID(),
                out float originalJumpImpulse))
        {
            return;
        }

        movement.jumpImpulse = originalJumpImpulse;
    }

    private static bool IsAirportScene(
        Scene scene)
    {
        if (!scene.IsValid() ||
            string.IsNullOrEmpty(scene.name))
        {
            return false;
        }

        return scene.name.IndexOf(
                   "Airport",
                   StringComparison.OrdinalIgnoreCase) >= 0;
    }

    private static bool IsGameplayMapScene(
        Scene scene)
    {
        if (!scene.IsValid() ||
            string.IsNullOrEmpty(scene.name))
        {
            return false;
        }

        return scene.name.StartsWith(
            "Level_",
            StringComparison.OrdinalIgnoreCase);
    }

    private static void ResetAllState()
    {
        airportWasVisited = false;
        waitingForFirstMapCharacter = false;
        firstMapProtectionConsumed = false;

        protectedSceneHandle = -1;

        jumpLockActive = false;
        protectedCharacterId = -1;
        jumpLockStartedAt = 0f;

        OriginalJumpImpulses.Clear();
    }

    [HarmonyPatch(
        typeof(CharacterMovement),
        "TryToJump")]
    private static class CharacterMovementTryToJumpPatch
    {
        [HarmonyPrefix]
        [HarmonyPriority(Priority.First)]
        private static bool Prefix(
            CharacterMovement __instance)
        {
            Character character;

            if (!ShouldBlockJump(
                    __instance,
                    out character))
            {
                return true;
            }

            CaptureOriginalJumpImpulse(__instance);
            RestoreOriginalJumpImpulse(__instance);

            return false;
        }
    }

    [HarmonyPatch(
        typeof(CharacterMovement),
        nameof(CharacterMovement.JumpRpc),
        new Type[]
        {
            typeof(bool)
        })]
    private static class CharacterMovementJumpRpcPatch
    {
        [HarmonyPrefix]
        [HarmonyPriority(Priority.First)]
        [HarmonyBefore(
            new string[]
            {
                "Sapphire009.JumpingPEAK",
                "Sapphire009.NoGround"
            })]
        private static bool Prefix(
            CharacterMovement __instance,
            bool __0,
            out bool __state)
        {
            __state = false;

            Character character;

            if (!ShouldBlockJump(
                    __instance,
                    out character))
            {
                return true;
            }

            CaptureOriginalJumpImpulse(__instance);
            RestoreOriginalJumpImpulse(__instance);

            __state = true;

            return false;
        }

        [HarmonyPostfix]
        [HarmonyPriority(Priority.Last)]
        [HarmonyAfter(
            new string[]
            {
                "Sapphire009.JumpingPEAK",
                "Sapphire009.NoGround"
            })]
        private static void Postfix(
            CharacterMovement __instance,
            bool __state)
        {
            if (!__state)
            {
                return;
            }

            RestoreOriginalJumpImpulse(__instance);
        }
    }
}
