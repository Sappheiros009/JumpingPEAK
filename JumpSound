using BepInEx;
using HarmonyLib;
using System;
using UnityEngine;
using UnityEngine.SceneManagement;

[BepInPlugin(PluginGUID, PluginName, PluginVersion)]
public sealed class JumpSound : BaseUnityPlugin
{
    public const string PluginGUID =
        "Sapphire009.JumpSound";

    public const string PluginName =
        "JumpSound";

    public const string PluginVersion =
        "1.0.1";

    private const float SoundSearchInterval =
        1f;

    private const int MinimumSoundScore =
        80;

    private static SFX_Instance sourceBounceSound;
    private static SFX_Instance runtimeJumpSound;

    private static float nextSoundSearchTime;

    private Harmony harmony;

    private void Awake()
    {
        harmony =
            new Harmony(PluginGUID);

        harmony.PatchAll();

        SceneManager.sceneLoaded +=
            OnSceneLoaded;

        TryFindBounceShroomSound();
    }

    private void Update()
    {
        if (runtimeJumpSound != null)
        {
            return;
        }

        if (Time.unscaledTime <
            nextSoundSearchTime)
        {
            return;
        }

        nextSoundSearchTime =
            Time.unscaledTime +
            SoundSearchInterval;

        TryFindBounceShroomSound();
    }

    private void OnDestroy()
    {
        SceneManager.sceneLoaded -=
            OnSceneLoaded;

        DestroyRuntimeSound();

        sourceBounceSound =
            null;

        if (harmony != null)
        {
            harmony.UnpatchSelf();
            harmony = null;
        }
    }

    private static void OnSceneLoaded(
        Scene scene,
        LoadSceneMode loadSceneMode)
    {
        nextSoundSearchTime =
            0f;

        if (runtimeJumpSound == null)
        {
            TryFindBounceShroomSound();
        }
    }

    internal static bool IsAirportScene()
    {
        string sceneName =
            SceneManager.GetActiveScene().name;

        if (string.IsNullOrEmpty(
                sceneName))
        {
            return false;
        }

        return sceneName.IndexOf(
                   "Airport",
                   StringComparison.OrdinalIgnoreCase) >= 0;
    }

    private static Character ResolveCharacter(
        Component component)
    {
        if (component == null)
        {
            return null;
        }

        Character character =
            component.GetComponent<Character>();

        if (character == null)
        {
            character =
                component.GetComponentInParent<Character>();
        }

        return character;
    }

    private static bool TryFindBounceShroomSound()
    {
        if (IsValidSound(
                runtimeJumpSound))
        {
            return true;
        }

        SFX_Instance selectedSound =
            null;

        int selectedScore =
            int.MinValue;

        CollisionModifier[] modifiers =
            Resources.FindObjectsOfTypeAll<
                CollisionModifier>();

        if (modifiers != null)
        {
            for (int i = 0;
                 i < modifiers.Length;
                 i++)
            {
                CollisionModifier modifier =
                    modifiers[i];

                if (modifier == null ||
                    !IsValidSound(
                        modifier.bounceSFX))
                {
                    continue;
                }

                string hierarchyText =
                    GetHierarchyText(
                        modifier.transform);

                string soundText =
                    GetSoundText(
                        modifier.bounceSFX);

                int score =
                    ScoreBounceShroomText(
                        hierarchyText);

                score +=
                    ScoreBounceShroomText(
                        soundText);

                if (modifier.knockback > 0f)
                {
                    score += 10;
                }

                if (score <=
                    selectedScore)
                {
                    continue;
                }

                selectedScore =
                    score;

                selectedSound =
                    modifier.bounceSFX;
            }
        }

        if (selectedSound == null ||
            selectedScore <
            MinimumSoundScore)
        {
            SFX_Instance[] sounds =
                Resources.FindObjectsOfTypeAll<
                    SFX_Instance>();

            if (sounds != null)
            {
                for (int i = 0;
                     i < sounds.Length;
                     i++)
                {
                    SFX_Instance sound =
                        sounds[i];

                    if (!IsValidSound(
                            sound))
                    {
                        continue;
                    }

                    string soundText =
                        GetSoundText(
                            sound);

                    int score =
                        ScoreBounceShroomText(
                            soundText);

                    if (score <=
                        selectedScore)
                    {
                        continue;
                    }

                    selectedScore =
                        score;

                    selectedSound =
                        sound;
                }
            }
        }

        if (selectedSound == null ||
            selectedScore <
            MinimumSoundScore)
        {
            return false;
        }

        SetBounceShroomSound(
            selectedSound);

        return runtimeJumpSound != null;
    }

    private static void SetBounceShroomSound(
        SFX_Instance sound)
    {
        if (!IsValidSound(
                sound))
        {
            return;
        }

        if (sourceBounceSound ==
                sound &&
            IsValidSound(
                runtimeJumpSound))
        {
            return;
        }

        DestroyRuntimeSound();

        sourceBounceSound =
            sound;

        runtimeJumpSound =
            UnityEngine.Object.Instantiate<
                SFX_Instance>(
                sourceBounceSound);

        if (runtimeJumpSound == null)
        {
            return;
        }

        runtimeJumpSound.name =
            "Sapphire009_JumpSound_BounceShroom";

        runtimeJumpSound.hideFlags =
            HideFlags.HideAndDontSave;
    }

    private static void DestroyRuntimeSound()
    {
        if (runtimeJumpSound == null)
        {
            return;
        }

        UnityEngine.Object.Destroy(
            runtimeJumpSound);

        runtimeJumpSound =
            null;
    }

    private static bool IsValidSound(
        SFX_Instance sound)
    {
        return
            sound != null &&
            sound.clips != null &&
            sound.clips.Length > 0;
    }

    private static string GetHierarchyText(
        Transform transform)
    {
        if (transform == null)
        {
            return string.Empty;
        }

        string result =
            string.Empty;

        Transform current =
            transform;

        int depth =
            0;

        while (current != null &&
               depth < 8)
        {
            if (!string.IsNullOrEmpty(
                    result))
            {
                result =
                    current.name +
                    "/" +
                    result;
            }
            else
            {
                result =
                    current.name;
            }

            current =
                current.parent;

            depth++;
        }

        return result;
    }

    private static string GetSoundText(
        SFX_Instance sound)
    {
        if (sound == null)
        {
            return string.Empty;
        }

        string result =
            sound.name;

        if (sound.clips == null)
        {
            return result;
        }

        for (int i = 0;
             i < sound.clips.Length;
             i++)
        {
            AudioClip clip =
                sound.clips[i];

            if (clip == null)
            {
                continue;
            }

            result +=
                "/" +
                clip.name;
        }

        return result;
    }

    private static int ScoreBounceShroomText(
        string text)
    {
        if (string.IsNullOrEmpty(
                text))
        {
            return 0;
        }

        string lowerText =
            text.ToLowerInvariant();

        int score =
            0;

        if (Contains(
                lowerText,
                "bounceshroom"))
        {
            score += 200;
        }

        if (Contains(
                lowerText,
                "bounce shroom"))
        {
            score += 200;
        }

        if (Contains(
                lowerText,
                "bounce_shroom"))
        {
            score += 200;
        }

        if (Contains(
                lowerText,
                "shroombounce"))
        {
            score += 180;
        }

        if (Contains(
                lowerText,
                "shroom bounce"))
        {
            score += 180;
        }

        if (Contains(
                lowerText,
                "mushroom bounce"))
        {
            score += 170;
        }

        if (Contains(
                lowerText,
                "bounce mushroom"))
        {
            score += 170;
        }

        if (Contains(
                lowerText,
                "bounce"))
        {
            score += 25;
        }

        if (Contains(
                lowerText,
                "shroom"))
        {
            score += 80;
        }

        if (Contains(
                lowerText,
                "mushroom"))
        {
            score += 70;
        }

        if (Contains(
                lowerText,
                "fungus"))
        {
            score += 50;
        }

        return score;
    }

    private static bool Contains(
        string source,
        string value)
    {
        return source.IndexOf(
                   value,
                   StringComparison.OrdinalIgnoreCase) >= 0;
    }

    private static void PlayJumpSound(
        Character character)
    {
        if (character == null ||
            IsAirportScene())
        {
            return;
        }

        if (!IsValidSound(
                runtimeJumpSound))
        {
            TryFindBounceShroomSound();
        }

        if (!IsValidSound(
                runtimeJumpSound) ||
            SFX_Player.instance == null)
        {
            return;
        }

        SFX_Player.instance.PlaySFX(
            runtimeJumpSound,
            character.Center,
            null,
            null,
            1f,
            false);
    }

    [HarmonyPatch(
        typeof(CharacterMovement),
        nameof(CharacterMovement.JumpRpc),
        new Type[]
        {
            typeof(bool)
        })]
    private static class CharacterMovementJumpRpcPatch
    {
        private sealed class JumpSoundState
        {
            public Character Character;

            public int JumpsRemainingBefore;

            public bool ChargingJumpBefore;

            public bool IsPalJump;

            public bool Valid;
        }

        [HarmonyPrefix]
        [HarmonyPriority(Priority.First)]
        [HarmonyBefore(
            new string[]
            {
                "Sapphire009.JumpingPEAK",
                "Sapphire009.BeforeStart"
            })]
        private static void Prefix(
            CharacterMovement __instance,
            bool __0,
            out JumpSoundState __state)
        {
            __state =
                new JumpSoundState();

            Character character =
                ResolveCharacter(
                    __instance);

            if (character == null ||
                character.data == null)
            {
                return;
            }

            __state.Character =
                character;

            __state.JumpsRemainingBefore =
                character.data.jumpsRemaining;

            __state.ChargingJumpBefore =
                character.data.chargingJump;

            __state.IsPalJump =
                __0;

            __state.Valid =
                true;
        }

        [HarmonyPostfix]
        [HarmonyPriority(Priority.Last)]
        private static void Postfix(
            JumpSoundState __state)
        {
            if (__state == null ||
                !__state.Valid ||
                __state.IsPalJump ||
                __state.Character == null ||
                __state.Character.data == null)
            {
                return;
            }

            Character character =
                __state.Character;

            bool jumpsDecreased =
                character.data.jumpsRemaining <
                __state.JumpsRemainingBefore;

            bool chargingStarted =
                !__state.ChargingJumpBefore &&
                character.data.chargingJump;

            if (!jumpsDecreased &&
                !chargingStarted)
            {
                return;
            }

            PlayJumpSound(
                character);
        }
    }
}
